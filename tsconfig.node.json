{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2023",

    /* Required pairing for node16 resolution */
    "module": "Node16",
    "moduleResolution": "Node16",

    "types": ["node"],

    "skipLibCheck": true,
    "noEmit": true,

    /* Keep minimal – this file is only for vite.config.ts */
    "strict": true
  },

  "include": ["vite.config.ts"]
}